<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.marioser.claude-mesh-bridge</string>
	<key>ProgramArguments</key>
	<array>
		<string>/path/to/claude-mesh-bridge</string>
		<string>run</string>
	</array>
	<key>KeepAlive</key>
	<true/>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>~/Library/Logs/claude-mesh-bridge.log</string>
	<key>StandardErrorPath</key>
	<string>~/Library/Logs/claude-mesh-bridge.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>CLAUDE_MESH_MQTT_HOST</key>
		<string>localhost</string>
		<key>CLAUDE_MESH_REDIS_ADDR</key>
		<string>localhost:6379</string>
	</dict>
</dict>
</plist>
